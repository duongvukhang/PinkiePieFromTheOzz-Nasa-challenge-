# SPHEREx Moving-Object & Trajectory Platform — Environment Template
# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL 16
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sphx
POSTGRES_USER=sphx
POSTGRES_PASSWORD=sphx_dev_password
DATABASE_URL=postgresql+psycopg://sphx:sphx_dev_password@db:5432/sphx

# Redis 7 & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Store (MinIO locally, S3 in production)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sphx
S3_REGION=us-east-1

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
