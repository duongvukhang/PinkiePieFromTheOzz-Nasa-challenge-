# SPHEREx Moving-Object & Trajectory Platform — Environment Template
# Copy to .env for local development or .env.prod for production deployments.

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=auto
SECRET_KEY=change-me-to-a-secure-random-secret-in-production

# API Gateway & Security
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PostgreSQL 16
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sphx
POSTGRES_USER=sphx
POSTGRES_PASSWORD=sphx_dev_password
DATABASE_URL=postgresql+psycopg://sphx:sphx_dev_password@db:5432/sphx

# Redis 7 & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Store (MinIO for VPS/local dev, AWS S3 / Cloudflare R2 in cloud)
SPHX_STORAGE_BACKEND=local
# SPHX_STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sphx
S3_REGION=us-east-1

# Frontend (Vite & Nginx)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
